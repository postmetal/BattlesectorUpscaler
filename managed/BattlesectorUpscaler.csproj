<Project Sdk="Microsoft.NET.Sdk">
  <!--
    IL2CPP build. The game has no Managed folder: BepInEx 6 generates interop assemblies into
    BepInEx\interop on the first launch, and that is what this project compiles against.

    Machine-specific paths go into local.props (git-ignored), or pass -p:GameDir=...
  -->
  <Import Project="local.props" Condition="Exists('local.props')" />
  <!-- Generated by scripts/build.ps1 only when NuGet is unreachable. -->
  <Import Project="offline.props" Condition="Exists('offline.props')" />

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>BattlesectorUpscaler</AssemblyName>
    <RootNamespace>BattlesectorUpscaler</RootNamespace>
    <LangVersion>latest</LangVersion>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <GameDir Condition="'$(GameDir)' == '' And '$(BATTLESECTOR_DIR)' != ''">$(BATTLESECTOR_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Warhammer 40,000 Battlesector</GameDir>

    <BepInExCore Condition="'$(BepInExCore)' == ''">$(GameDir)\BepInEx\core</BepInExCore>
    <InteropDir Condition="'$(InteropDir)' == ''">$(GameDir)\BepInEx\interop</InteropDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core">
      <HintPath>$(BepInExCore)\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(BepInExCore)\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(BepInExCore)\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Everything BepInEx generated for this game: UnityEngine.*, Assembly-CSharp, Il2Cppmscorlib. -->
    <Reference Include="$(InteropDir)\*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(GameDir)\BepInEx\plugins')">
    <MakeDir Directories="$(GameDir)\BepInEx\plugins\BattlesectorUpscaler" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins\BattlesectorUpscaler" ContinueOnError="true" />
    <Message Importance="high" Text="Deployed $(TargetFileName) to $(GameDir)\BepInEx\plugins\BattlesectorUpscaler (copy may have been skipped if the game folder needs admin rights)" />
  </Target>
</Project>
